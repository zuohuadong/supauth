{
  "name": "@supauth/authorization-postgres",
  "version": "0.4.2",
  "description": "Reviewable PostgreSQL and Supabase RLS generators for application-owned authorization",
  "type": "module",
  "sideEffects": false,
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "clean": "bun -e \"const fs = await import('node:fs/promises'); await fs.rm('dist', { recursive: true, force: true });\"",
    "build": "bun run clean && bunx tsc -p tsconfig.json",
    "prepack": "bun run build",
    "typecheck": "bunx tsc --noEmit",
    "test": "bun test"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vibeunion/supauth.git",
    "directory": "packages/authorization-postgres"
  },
  "devDependencies": {
    "@types/bun": "^1.4.0",
    "postgres": "^3.4.9",
    "typescript": "^5.8.0"
  }
}
