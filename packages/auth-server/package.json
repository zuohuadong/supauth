{
  "name": "@supauth/auth-server",
  "version": "0.8.9",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun run ../../scripts/dev-supauth-function.ts",
    "build": "bun run build:function",
    "build:function": "bun run ../../scripts/generate-hosted-pages.ts && bun run ../../scripts/build-supauth-function.ts",
    "migrate": "echo 'Direct DB migration is removed; deploy through the SupaCloud app installer so migrations are hosted by SupaCloud Management API.' && exit 1",
    "start": "echo 'SupAuth has no standalone start command. Deploy dist/supacloud-function/supacloud-function.js to SupaCloud Functions.' && exit 1",
    "typecheck": "bunx tsc --noEmit",
    "test": "bun test --isolate src/__tests__"
  },
  "dependencies": {
    "@elysiajs/cors": "^1.4.2",
    "@elysiajs/swagger": "^1.3.1",
    "@supauth/shared": "workspace:*",
    "drizzle-orm": "^0.45.2",
    "elysia": "^1.4.30",
    "fflate": "^0.8.3",
    "file-type": "^22.0.2",
    "jose": "^6.2.10",
    "pinyin-pro": "^3.29.3",
    "postgres": "3.4.9"
  },
  "devDependencies": {
    "@types/bun": "^1.4.0",
    "drizzle-kit": "^0.31.10",
    "typescript": "^6.0.3"
  }
}
